	"authors": [
		"brainage04"
	],
	"contact": {
		"homepage": "https://github.com/brainage04/SimpleTPA",
		"sources": "https://github.com/brainage04/SimpleTPA"
	},
	"license": "MIT",
	"icon": "assets/simpletpa/icon.png",
